# ResQ Environment Variables — copy to .env and fill in

# Gemini API (REQUIRED) – paste your own key here.  The value
# shown below is just an example; don’t commit real keys to version
# control.
GEMINI_API_KEY=AIzaSyClnVoBxvN3V0y8_eRQWR-un_8jtPro3oU
# Optional override for the model name (default is gemini-2.0-flash).
# Paid/pro keys may be able to use `gemini-2.0-pro` or others.
# If the selected model hits quota the service will back off for a short
# period and resume with defaults rather than crashing.
GEMINI_MODEL=gemini-2.0-flash

# GNews API — RECOMMENDED for real current news
# Free tier: 100 requests/day — signup at https://gnews.io
# Without this, app falls back to RSS feeds or Gemini's own knowledge
GNEWS_API_KEY=9b96334973d1d1b0481d2e17d3c21cd0
NEWSDATA_API_KEY=pub_8879cbe8fcb146c78dfd6ce75d4d9cfc

# OpenWeatherMap (free tier works)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# SMTP for email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Messaging integrations intentionally disabled for now.

# App settings
INGESTION_INTERVAL_SECONDS=120
SAFETY_LOOP_TIMEOUT_MINUTES=15
